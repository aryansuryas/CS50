## 16. Quick Reference Cheat Sheet

### Full Program Template

```c
#include <cs50.h>
#include <stdio.h>

// Prototype
void print_row(int width);

int main(void)
{
    int n = get_int("Size: ");

    for (int i = 1; i <= n; i++)
    {
        print_row(i);
    }

    return 0;
}

void print_row(int width)
{
    for (int j = 0; j < width; j++)
